# Server
APP_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+asyncpg://reportapi:reportapi@postgres:5432/reportapi

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Jira connector
JIRA_URL=https://yourcompany.atlassian.net
# Exact origins authorized by the operator; UI saves cannot change this list.
JIRA_ALLOWED_ORIGINS=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Asana connector
ASANA_PAT=

# GitHub Issues connector
GITHUB_PAT=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# Production refuses to start without this token. Development without a token
# is for loopback-only use. All /api/* requests require it when set.
CONFIG_API_TOKEN=

# Explicitly authorized local LLM (defaults match the Compose Ollama profile).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_ALLOWED_ORIGINS=http://ollama:11434
OUTBOUND_PRIVATE_ORIGINS=http://ollama:11434

# Set true for externally managed secrets; ignores UI overrides and disables saves.
CONFIG_READ_ONLY=false
# Compose sets this to /config/runtime.env on the shared runtime_config volume.
CONFIG_STORE_PATH=runtime-config.env
