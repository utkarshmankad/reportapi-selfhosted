# Server
APP_ENV=development
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql+asyncpg://reportapi:reportapi@postgres:5432/reportapi

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Jira connector
JIRA_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Asana connector
ASANA_PAT=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Config UI auth — set this if the api port (8000) is reachable from
# anywhere other than your own machine. Config UI requests must then send
# it as the X-Config-Token header. Leave blank for local-only setups.
CONFIG_API_TOKEN=
